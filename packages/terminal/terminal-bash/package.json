{
  "name": "@const-ai/terminal-bash",
  "description": "Persistent shell PTY backend over the DeepSeek Harness subprocess terminal primitive",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@const-ai/agent": "workspace:^",
    "@const-ai/invariants": "workspace:^",
    "@const-ai/terminal": "workspace:^",
    "@const-ai/sandbox": "workspace:^",
    "@const-ai/sandbox-policy": "workspace:^",
    "@const-ai/session": "workspace:^",
    "@const-ai/subprocess": "workspace:^",
    "@const-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@const-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@const-ai/agent": "workspace:^",
    "@const-ai/invariants": "workspace:^",
    "@const-ai/terminal": "workspace:^",
    "@const-ai/sandbox": "workspace:^",
    "@const-ai/sandbox-policy": "workspace:^",
    "@const-ai/session": "workspace:^",
    "@const-ai/subprocess": "workspace:^",
    "@const-ai/subprocess-local": "workspace:^",
    "@const-ai/cordis": "workspace:^"
  }
}
