    "@const-ai/subagent": "workspace:^",
    "@const-ai/subprocess": "workspace:^",
    "@const-ai/timeout": "workspace:^",
    "@const-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@const-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@const-ai/cordis-plugin-loader": "workspace:^",
    "@const-ai/agent": "workspace:^",
    "@const-ai/invariants": "workspace:^",
    "@const-ai/llm": "workspace:^",
    "@const-ai/loader-smoke": "workspace:^",
    "@const-ai/sdk-protocol": "workspace:^",
    "@const-ai/session": "workspace:^",
    "@const-ai/subagent": "workspace:^",
    "@const-ai/subprocess": "workspace:^",
    "@const-ai/subprocess-local": "workspace:^",
    "@const-ai/timeout": "workspace:^",
    "@openai/codex": "0.147.0",
    "@const-ai/cordis": "workspace:^"
  }
