{
  "name": "@const-ai/client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@const-ai/client-locale",
        "@const-ai/client-runtime",
        "@const-ai/client-ui-conversation",
        "@const-ai/client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@const-ai/client-locale": "workspace:^",
    "@const-ai/client-runtime": "workspace:^",
    "@const-ai/client-ui-primitives": "workspace:^",
    "@const-ai/client-ui-slots": "workspace:^",
    "@const-ai/invariants": "workspace:^",
    "@const-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@const-ai/client-locale": "workspace:^",
    "@const-ai/client-runtime": "workspace:^",
    "@const-ai/client-test-runtime": "workspace:^",
    "@const-ai/client-ui-conversation": "workspace:^",
    "@const-ai/client-ui-primitives": "workspace:^",
    "@const-ai/client-ui-sidebar": "workspace:^",
    "@const-ai/client-ui-slots": "workspace:^",
    "@const-ai/invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@const-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
