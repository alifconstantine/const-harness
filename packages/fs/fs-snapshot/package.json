{
  "name": "@const-ai/fs-snapshot",
  "description": "Shadow Git snapshot engine and file rollback service for Const Harness (ctx.snapshot)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/fs-snapshot"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@const-ai/home-paths": "workspace:^",
    "@const-ai/session": "workspace:^"
  },
  "peerDependencies": {
    "@const-ai/cordis": "workspace:^",
    "@const-ai/home-paths": "workspace:^",
    "@const-ai/invariants": "workspace:^",
    "@const-ai/session": "workspace:^"
  },
  "devDependencies": {
    "@const-ai/cordis": "workspace:^",
    "@const-ai/invariants": "workspace:^"
  }
}
