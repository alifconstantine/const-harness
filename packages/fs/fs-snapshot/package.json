{
  "name": "@deepseek-ai/dsh-fs-snapshot",
  "description": "Shadow Git snapshot engine and file rollback service for Const Harness (ctx.snapshot)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
